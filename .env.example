# Скопируйте в .env и измените при необходимости. Все переменные необязательны.
APP_ENV=local
POSTGRES_PASSWORD=scc
JWT_SECRET=change-me-in-production-please-32b
# Пауза между шагами конвейера, сек (чтобы на демо было видно движение статусов; 0 — без пауз)
PIPELINE_STEP_DELAY_SEC=1.5
# Заявки на сумму выше — только ручное рассмотрение
AUTO_DECISION_LIMIT=15000000
WORKER_REPLICAS=2
# Внешние порты на вашем компьютере; поменяйте, если порт занят (ошибка «port is already allocated»)
WEB_PORT=8080
API_PORT=8000
MOCKS_PORT=8090
# Языковая модель (профиль ai). Пустое значение отключает LLM полностью
LLM_URL=http://ollama:11434
LLM_MODEL=qwen2.5:1.5b
